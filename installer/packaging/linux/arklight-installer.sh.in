#!/bin/sh
# Generated by CMake (installer/CMakeLists.txt) — do not edit the installed
# copy directly, edit arklight-installer.sh.in instead.
#
# neu's build output is named gui-linux_x64 and needs resources.neu sitting
# next to it, not on PATH — this wrapper is what actually lands as
# `arklight-installer` on PATH per the .desktop file's Exec= line.
exec "@ARK_INSTALL_PREFIX@/share/arklight-installer/@ARK_BINARY_NAME@-linux_x64" "$@"
